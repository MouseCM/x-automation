# Copy to .env and fill in what you use:   cp .env.example .env
# .env is git-ignored. Every key is optional. A variable set with `export` overrides this file.

# --------------------------------------------------------------------------- Gemini (summaries + drafts)
# Free key: https://aistudio.google.com/apikey  (GOOGLE_API_KEY works too)
GEMINI_API_KEY=
# Model for one-line crawler summaries
GEMINI_MODEL=gemini-3.1-flash-lite
# Draft writers to try in order, comma-separated. Pro models need billing on the Google account.
GEMINI_DRAFT_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.1-flash-lite

# --------------------------------------------------------------------------- search engine APIs (crawler)
# Scraped engines (ddgs, duckduckgo, yahoo, ...) need nothing. API engines are skipped without their key.
BRAVE_API_KEY=       # brave_api  https://brave.com/search/api/  ($5/month free credit)
SERPER_API_KEY=      # serper     https://serper.dev             (2,500 free queries)
TAVILY_API_KEY=      # tavily     https://tavily.com             (1,000 free credits/month)
EXA_API_KEY=         # exa        https://exa.ai                 (pay as you go)
SEARXNG_URL=         # searxng    your own instance, e.g. http://localhost:8888

# --------------------------------------------------------------------------- X account (Studio publishing)
# Easiest to set on the Studio's "X account" tab, which writes these lines for you.
# api | cookies | password  (blank = first mode whose keys are all set)
X_AUTH_MODE=
# api mode: developer.x.com app with Read and write
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# cookies mode: auth_token and ct0 cookies from a browser logged in to x.com
X_AUTH_TOKEN=
X_CT0=
# password mode (X_EMAIL and X_TOTP_SECRET optional)
X_USERNAME=
X_EMAIL=
X_PASSWORD=
X_TOTP_SECRET=
# Post length limit. 280 for standard accounts; raise only for X Premium (api mode).
X_MAX_CHARS=280

# --------------------------------------------------------------------------- Studio server
STUDIO_PORT=8787
# 1 = share on your Wi-Fi/LAN by default (same as `studio.py --lan`); `studio.py --local` overrides
STUDIO_LAN=
# Access code for LAN mode; blank = one is generated and saved here on the next start
STUDIO_ACCESS_CODE=
